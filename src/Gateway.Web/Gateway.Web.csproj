<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Gateway.Core\Gateway.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- La pagina viaja adentro del assembly, no como archivo suelto: evita
         depender del working directory (dotnet run vs el .exe desde bin/) y en
         la Fase 7, como servicio de Windows, es un archivo menos que copiar.
         LogicalName explicito para que el nombre del recurso no dependa de la
         convencion de carpetas y sobreviva a mover el archivo. -->
    <EmbeddedResource Include="Assets\diagnostics.html" LogicalName="diagnostics.html" />
  </ItemGroup>
  <ItemGroup>
    <!-- Acceso al framework compartido de ASP.NET Core sin convertir este
         proyecto en una app web: el arranque sigue siendo de Gateway.Host.
         Es transitivo, asi que el host lo hereda sin cambios en su csproj. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
