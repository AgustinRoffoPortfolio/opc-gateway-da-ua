{
  "Ua": {
    "ApplicationName": "OpcGatewayDaUa",
    "EndpointUrl": "opc.tcp://localhost:4840/GatewayDaUa",
    "NamespaceUri": "http://opc-gateway-da-ua/",
    "UpdateIntervalMs": 1000,
    "TagsCsvPath": "config/tags.example.csv",
    "PkiRoot": "pki",
        "_comment_AutoAccept": "true acepta cualquier certificado de cliente sin validar. Solo para desarrollo local: en cualquier otro contexto va en false y los clientes se habilitan moviendo su certificado a pki/trusted/certs.",
    "AutoAcceptUntrustedCertificates": false,
    "DiagnosticsEnabled": true
  },
  "Web": {
    "ListenUrl": "http://localhost:8080",
    "Enabled": true
  },
  "Da": {
    "ProgId": "Matrikon.OPC.Simulation.1",
    "StaleAfterCycles": 3,
    "ReconnectDelayMs": 5000,
    "ItemRetryIntervalMs": 30000,
    "UpdateRateMs": 1000
  }
}
