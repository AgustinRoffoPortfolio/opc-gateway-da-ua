<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- El driver DA obliga a un proceso de 32 bits, igual que Gateway.Host:
         el ejecutable manda sobre todas las bibliotecas que carga. -->
    <PlatformTarget>x86</PlatformTarget>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Gateway.Da\Gateway.Da.csproj" />
  </ItemGroup>
</Project>